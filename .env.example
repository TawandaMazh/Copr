# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Phase 2+) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (MockProvider is default — no keys needed) ───
PAYMENT_PROVIDER=mock
# MTN_MOMO_API_KEY=
# AIRTEL_MONEY_API_KEY=
# CARD_AGGREGATOR_API_KEY=

# Optional: enable Supabase phone OTP in the dashboard (Auth → Providers → Phone)
# and Email OTP (Auth → Providers → Email). Without keys, the app uses local demo auth.

# ─── Marketplace defaults (Phase 4 admin can override) ───
NEXT_PUBLIC_DEFAULT_COMMISSION_PERCENT=15
NEXT_PUBLIC_DELIVERY_FEE_KWACHA=50
NEXT_PUBLIC_DELIVERY_CITY=Lusaka
