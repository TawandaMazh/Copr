# ─── App ───
NEXT_PUBLIC_APP_URL=https://copr-phi.vercel.app

# ─── Supabase (Phase 2+) ───
# Project URL only — do NOT include /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
# Legacy anon JWT (eyJ…) or publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: legacy service_role JWT or sb_secret_… (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (MockProvider is default — no keys needed) ───
PAYMENT_PROVIDER=mock
# MTN_MOMO_API_KEY=
# AIRTEL_MONEY_API_KEY=
# CARD_AGGREGATOR_API_KEY=

# Optional: enable Supabase phone OTP in the dashboard (Auth → Providers → Phone)
# and Email OTP (Auth → Providers → Email). Without keys, the app uses local demo auth.

# Protects /api/cron/auto-confirm (Vercel Cron Authorization: Bearer …)
# CRON_SECRET=

# Resend — OTP codes + order emails (buyer confirmation + owner alert)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=copr <onboarding@resend.dev>
# Inbox that receives a copy whenever an order is placed / a problem is reported
# ORDER_NOTIFY_EMAIL=
# Public support address for mailto fallbacks (can match ORDER_NOTIFY_EMAIL)
# NEXT_PUBLIC_SUPPORT_EMAIL=

# WhatsApp chat float (digits with country code, e.g. 260971234567)
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Marketplace defaults (Phase 4 admin can override) ───
NEXT_PUBLIC_DEFAULT_COMMISSION_PERCENT=15
NEXT_PUBLIC_DELIVERY_FEE_KWACHA=50
NEXT_PUBLIC_DELIVERY_CITY=Lusaka
